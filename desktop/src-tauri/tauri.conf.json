{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Butter",
  "version": "0.1.23",
  "identifier": "app.butter.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Butter",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "theme": "Dark",
        "center": true,
        "maximizable": true,
        "minWidth": 1040,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:* https:; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend-dist/butter-backend.dist": "backend"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0RjM4QzZCQkI0OUVCRDcKUldUWDYwbTdhNHp6ZE1ERFpmaVYzMExCMjNQM3p3eW83YUZtSXVjbEdUelRSWHRHY1NsZ2RGMXUK",
      "endpoints": [
        "https://raw.githubusercontent.com/joltzeal/butter/refs/heads/latest/latest.json"
      ]
    }
  }
}
